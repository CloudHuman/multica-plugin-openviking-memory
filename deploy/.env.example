# Copy to deploy/.env (gitignored) and fill in.
# OpenViking instance
OVMEM_OV_BASE_URL=https://ov.example.com
OVMEM_OV_ROOT_KEY=change-me-root-key

# Multica plugin hook signing secret (whsec_… from the plugin token rotation
# response in workspace Settings → Plugins). Rotate → copy → restart service.
# It serves ONE installation, bound to its workspace on first delivery.
OVMEM_SIGNING_SECRET=whsec_change_me

# Serving several workspaces: one entry per installation. Pin each to its
# workspace, or set OVMEM_MULTICA_API_URL so the service verifies the workspace
# through GET /v1/context before trusting a new installation.
# OVMEM_SIGNING_SECRETS={"<installation_id>":{"secret":"whsec_…","workspace_id":"<workspace_id>"}}
# OVMEM_MULTICA_API_URL=https://multica.example.com/v1

# Bearer token guarding /internal/* and /admin/* — long random string
OVMEM_PLUGIN_TOKEN=change-me-long-random

# Optional TLS (e.g. /certs/hook-server.pem from deploy/dev-certs.sh)
OVMEM_TLS_CERT=
OVMEM_TLS_KEY=
