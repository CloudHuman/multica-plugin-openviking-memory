+		t.Fatalf("task = %+v, want a chat run of %s", task, testUserID)
+	}
+	if len(task.Input) != 0 {
+		t.Fatalf("input = %+v, want the chat message withheld without chats:read", task.Input)
+	}
+	recorder, _ = listPluginTaskMessages(t, pluginActionRequest(http.MethodGet, "/v1/tasks/"+taskID+"/messages", withoutChats, nil, params))
