Subject: [PATCH] fix(plugins): issue daemon credentials for hook-only tasks

---
 server/internal/handler/agent.go              |  2 +-
 server/internal/handler/daemon.go             |  4 +-
 .../handler/plugin_agent_claim_token_test.go  | 38 +++++++++++++++++++
 3 files changed, 41 insertions(+), 3 deletions(-)
 create mode 100644 server/internal/handler/plugin_agent_claim_token_test.go

diff --git a/server/internal/handler/agent.go b/server/internal/handler/agent.go
index fc6f50c..b79c4db 100644
--- a/server/internal/handler/agent.go
+++ b/server/internal/handler/agent.go
@@ -376,7 +376,7 @@ type AgentTaskResponse struct {
 	// than whenever a daemon happens to restart.
 	PluginHookTools []service.PluginHookTool `json:"plugin_hook_tools,omitempty"`
 	// RemoteMCPDaemonToken is a short-lived, workspace-and-daemon scoped
-	// credential used only by the local daemon's write-only Remote MCP broker.
+	// credential used by the local daemon's Remote MCP and plugin hook brokers.
 	// It is never injected into the agent process.
 	RemoteMCPDaemonToken string `json:"remote_mcp_daemon_token,omitempty"`
 	// WorkspaceContext is the workspace-level system prompt set in workspace
diff --git a/server/internal/handler/daemon.go b/server/internal/handler/daemon.go
index 247482d..c53053c 100644
--- a/server/internal/handler/daemon.go
+++ b/server/internal/handler/daemon.go
@@ -2211,11 +2211,11 @@ func (h *Handler) rejectClaimOnWorkspaceMismatch(ctx context.Context, task *db.A
 }
 
 // remoteMCPDaemonTokenForClaim prepares the short-lived credential the daemon
-// uses to resolve write-only Remote MCP secrets for this task. The raw token is
+// uses to resolve Remote MCP secrets and invoke plugin hooks for this task. The raw token is
 // returned only in the claim response; its hash is committed atomically with
 // the task-scoped agent token by FinalizeTaskClaim.
 func remoteMCPDaemonTokenForClaim(resp AgentTaskResponse, runtime db.AgentRuntime) (string, []db.CreateDaemonTokenParams, error) {
-	if len(resp.RemoteMCPConnections) == 0 {
+	if len(resp.RemoteMCPConnections) == 0 && len(resp.PluginHookTools) == 0 {
 		return "", nil, nil
 	}
 	if !runtime.DaemonID.Valid || strings.TrimSpace(runtime.DaemonID.String) == "" {
diff --git a/server/internal/handler/plugin_agent_claim_token_test.go b/server/internal/handler/plugin_agent_claim_token_test.go
new file mode 100644
index 0000000..088e76d
--- /dev/null
+++ b/server/internal/handler/plugin_agent_claim_token_test.go
@@ -0,0 +1,38 @@
+package handler
+
+import (
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/multica-ai/multica/server/internal/auth"
+	"github.com/multica-ai/multica/server/internal/service"
+	db "github.com/multica-ai/multica/server/pkg/db/generated"
+)
+
+func TestPluginHookOnlyClaimHasDaemonCredential(t *testing.T) {
+	runtime := db.AgentRuntime{
+		WorkspaceID: parseUUID(testWorkspaceID),
+		DaemonID:    strToText("plugin-only-daemon"),
+	}
+	response := AgentTaskResponse{PluginHookTools: []service.PluginHookTool{{Name: "memory-recall"}}}
+	raw, params, err := remoteMCPDaemonTokenForClaim(response, runtime)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.HasPrefix(raw, "mdt_") || len(params) != 1 {
+		t.Fatal("plugin-only claims must carry a persisted daemon credential")
+	}
+	if params[0].TokenHash != auth.HashToken(raw) || params[0].WorkspaceID != runtime.WorkspaceID || params[0].DaemonID != runtime.DaemonID.String {
+		t.Fatal("plugin hook credential must remain bound to this workspace and daemon")
+	}
+	if remaining := time.Until(params[0].ExpiresAt.Time); remaining < 23*time.Hour || remaining > 24*time.Hour {
+		t.Fatalf("unexpected credential lifetime: %s", remaining)
+	}
+	if _, _, err := remoteMCPDaemonTokenForClaim(response, db.AgentRuntime{WorkspaceID: runtime.WorkspaceID}); err == nil {
+		t.Fatal("plugin-only claims without a daemon identity must fail closed")
+	}
+	if raw, params, err := remoteMCPDaemonTokenForClaim(AgentTaskResponse{}, runtime); err != nil || raw != "" || len(params) != 0 {
+		t.Fatal("claims without plugin or remote MCP tools must not mint a credential")
+	}
+}
